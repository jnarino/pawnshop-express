# Dockerfile for Python Migration Scripts
FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    freetds-dev \
    freetds-bin \
    unixodbc-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /migration

# Copy requirements and install Python packages
COPY pawnshop-express/migration/sql-server-to-postgresql/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy migration scripts
COPY pawnshop-express/migration/sql-server-to-postgresql/ .

# Copy .env file
COPY pawnshop-express/.env .

# Default command
CMD ["python3", "scripts/migrate_all.py"]
